# MCP server authentication. Replace both values before running locally.
MCP_JWT_SECRET=replace-with-at-least-32-random-characters
MCP_APPROVAL_SECRET=replace-with-a-different-32-character-secret
MCP_JWT_ISSUER=secure-mcp-lab-auth
MCP_JWT_AUDIENCE=secure-mcp-lab-server
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Optional SharedLLM routing. The lab works without these values.
SHAREDLLM_BASE_URL=https://api.sharedllm.com/openai/v1
SHAREDLLM_MODEL=kimi-k2.7-code
SHAREDLLM_API_KEY=

